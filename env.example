# Copy to .env.local and fill in. Only the contact form needs these.

# Resend API key. Get one at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# Where contact form submissions are delivered.
CONTACT_EMAIL_TO=you@example.com

# Optional. Sender address; defaults to noreply@resend.dev
# CONTACT_EMAIL_FROM=noreply@yourdomain.com

# Optional. Submission throttle; defaults to 1 submission per 5 minutes.
# RATE_LIMIT_WINDOW_MS=300000
# RATE_LIMIT_MAX_REQUESTS=1
